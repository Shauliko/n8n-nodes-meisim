{
  "name": "n8n-nodes-meisim",
  "version": "0.1.1",
  "description": "n8n nodes for MeiSIM USA: real US mobile numbers for AI agents and apps. Send and receive texts, manage lines, order numbers, get your SIP login.",
  "keywords": [
    "n8n-community-node-package",
    "sms",
    "text message",
    "phone number",
    "us number",
    "ai agent",
    "voice agent",
    "t-mobile",
    "esim",
    "meisim"
  ],
  "license": "MIT",
  "homepage": "https://www.meisimusa.com/api-for-ai-agents.html",
  "author": {
    "name": "MeiSIM USA",
    "email": "support@meisimusa.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shauliko/n8n-nodes-meisim.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node scripts/smoke-test.js",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease && npm test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MeisimApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Meisim/Meisim.node.js",
      "dist/nodes/Meisim/MeisimTrigger.node.js",
      "dist/nodes/Meisim/MeisimPollTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.3",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.4",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
